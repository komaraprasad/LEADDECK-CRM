DATABASE_URL=postgresql+psycopg://user:password@host/dbname
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me   # at least 8 characters, or the app will not start
SYNC_TOKEN=

# Phase 2 enrichment (never commit real keys)
ROCKETREACH_API_KEY=
ENRICH_DEFAULT_CREDIT_CAP=25
ENRICH_DEFAULT_LEAD_CAP=10

# Phase 3/4 event intake (leave empty to disable the endpoint)
CRM_EVENT_TOKEN=

# Time zone of tool timestamps that carry none (the four tools record India time)
TOOL_UTC_OFFSET=+05:30
